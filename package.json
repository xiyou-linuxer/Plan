{
  "name": "xlg-plan",
  "version": "3.2.0",
  "description": "西邮Linux兴趣小组培养计划",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind && recursive-copy public/_pagefind out/_pagefind --overwrite",
    "start": "next start",
    "preview": "pnpx serve out",
    "clean:cache": "pnpx rimraf .next out public/_pagefind",
    "lint": "prettier --check \"./**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint:fix": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@theguild/remark-mermaid": "0.3.0",
    "next": "^16.2.12",
    "nextra": "4.6.0",
    "nextra-theme-docs": "4.6.0",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.37",
    "@iconify/tailwind4": "^1.2.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-lint-md": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "recursive-copy-cli": "^1.0.20",
    "typescript": "^5.9.3"
  }
}
